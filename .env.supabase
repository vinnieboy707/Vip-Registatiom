# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# NHTSA API
NHTSA_API_BASE_URL=https://vpic.nhtsa.dot.gov/api

# State DMV API (Optional)
DMV_API_KEY=your-state-dmv-api-key
DMV_API_BASE_URL=https://api.yourstatedmv.gov/v1

# Environment
NODE_ENV=production

# JWT for custom edge functions (if needed)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Webhook secrets
WEBHOOK_SECRET=your-webhook-secret-for-validation

# Email service (Supabase provides this)
SMTP_HOST=smtp.supabase.io
SMTP_PORT=587
